{
  "name": "@mosaik3lab/server",
  "version": "1.6.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "cross-env NODE_ENV=production tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=dot test/*.test.ts",
    "seed:reset": "tsx scripts/reset-data.ts",
    "backup": "tsx scripts/backup.ts",
    "bundle": "tsx scripts/bundle.ts",
    "mail:test": "tsx scripts/mail-test.ts",
    "mail:vorschau": "tsx scripts/mail-vorschau.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "user:create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@mosaik3lab/shared": "*",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "jpeg-js": "^0.4.4",
    "multer": "^2.0.1",
    "nodemailer": "^10.3.1",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=24"
  }
}
